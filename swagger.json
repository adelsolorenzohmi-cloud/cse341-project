{
    "swagger": "2.0",
    "info": {
        "version": "1.0.0",
        "title": "Comunidad Proyectos API",
        "description": "API for managing community zones and infrastructure projects in Guatemala."
    },
    "host": "cse341-project-n61w.onrender.com",
    "basePath": "/",
    "schemes": [
        "http",
        "https"
    ],
    "consumes": [
        "application/json"
    ],
    "produces": [
        "application/json"
    ],
    "paths": {
        "/zones": {
            "get": {
                "summary": "Get all zones",
                "responses": {
                    "200": {
                        "description": "A list of all community zones"
                    }
                }
            },
            "post": {
                "summary": "Create a new zone",
                "parameters": [
                    {
                        "name": "zone",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "properties": {
                                "zoneName": {
                                    "type": "string"
                                },
                                "municipality": {
                                    "type": "string"
                                },
                                "department": {
                                    "type": "string"
                                },
                                "totalPopulation": {
                                    "type": "integer"
                                },
                                "communityLeaderName": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Zone created successfully"
                    }
                }
            }
        },
        "/zones/{id}": {
            "get": {
                "summary": "Get a zone by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Zone details"
                    },
                    "404": {
                        "description": "Zone not found"
                    }
                }
            },
            "put": {
                "summary": "Update a zone by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string"
                    },
                    {
                        "name": "zone",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "properties": {
                                "zoneName": {
                                    "type": "string"
                                },
                                "municipality": {
                                    "type": "string"
                                },
                                "department": {
                                    "type": "string"
                                },
                                "totalPopulation": {
                                    "type": "integer"
                                },
                                "communityLeaderName": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Zone updated successfully"
                    }
                }
            },
            "delete": {
                "summary": "Delete a zone by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Zone deleted successfully"
                    }
                }
            }
        },
        "/projects": {
            "get": {
                "summary": "Get all infrastructure projects",
                "responses": {
                    "200": {
                        "description": "A list of all projects"
                    }
                }
            },
            "post": {
                "summary": "Create a new project",
                "parameters": [
                    {
                        "name": "project",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "properties": {
                                "projectName": {
                                    "type": "string"
                                },
                                "projectType": {
                                    "type": "string"
                                },
                                "budgetQuetzales": {
                                    "type": "number"
                                },
                                "status": {
                                    "type": "string",
                                    "enum": [
                                        "Planning",
                                        "In Progress",
                                        "Completed"
                                    ]
                                },
                                "startDate": {
                                    "type": "string",
                                    "format": "date"
                                },
                                "estimatedEndDate": {
                                    "type": "string",
                                    "format": "date"
                                },
                                "beneficiaryFamiliesCount": {
                                    "type": "integer"
                                },
                                "zoneId": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Project created successfully"
                    }
                }
            }
        },
        "/projects/{id}": {
            "get": {
                "summary": "Get a project by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Project details"
                    }
                }
            },
            "put": {
                "summary": "Update a project by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string"
                    },
                    {
                        "name": "project",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "properties": {
                                "projectName": {
                                    "type": "string"
                                },
                                "projectType": {
                                    "type": "string"
                                },
                                "budgetQuetzales": {
                                    "type": "number"
                                },
                                "status": {
                                    "type": "string",
                                    "enum": [
                                        "Planning",
                                        "In Progress",
                                        "Completed"
                                    ]
                                },
                                "startDate": {
                                    "type": "string",
                                    "format": "date"
                                },
                                "estimatedEndDate": {
                                    "type": "string",
                                    "format": "date"
                                },
                                "beneficiaryFamiliesCount": {
                                    "type": "integer"
                                },
                                "zoneId": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Project updated successfully"
                    }
                }
            },
            "delete": {
                "summary": "Delete a project by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Project deleted successfully"
                    }
                }
            }
        }
    }
}